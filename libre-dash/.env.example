# LibreLinkUp credentials (the *LibreLinkUp* follower account, not the LibreLink app account)
LIBRE_EMAIL=amirdessouky@gmail.com
LIBRE_PASSWORD=Beertje2003!

# Regional endpoint host. Login auto-redirects if this is wrong, but setting it
# right avoids a round-trip. Common: api-eu, api-eu2, api-us, api-de, api-fr,
# api-jp, api-ap, api-au, api-ca, api-la, api-ru
LIBRE_REGION=api-eu

# mmol/L or mg/dL
LIBRE_UNITS=mmol
