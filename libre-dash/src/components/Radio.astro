---
import RadioCard from "./RadioCard.astro";
import type { Beat } from "../lib/beats";

interface Props {
  radioCards: Beat[];
}

const { radioCards } = Astro.props;
---

<section class="radio">
  <!-- Title and deck travel together: clicking the title lifts this block out
       of the window and onto the desktop. The play button and the queue below
       stay behind. Laid out by .radio's own flex order, so the title still
       reads as a head row next to the button while it is docked. -->
  <div class="radio-stage" id="radio-stage">
    <h1
      class="radio-head-title"
      id="radio-eject"
      role="button"
      tabindex="0"
      aria-pressed="false"
      title="jump out"
    >
      RADIO
    </h1>

    {
      radioCards.length > 0 && (
        <div class="radio-deck">
          {radioCards.map((card, index) => (
            <RadioCard
              title={card.title}
              tempo={card.tempo}
              mp3Url={card.mp3Url}
              isFirst={index === 0}
              index={index}
            />
          ))}
        </div>
      )
    }
  </div>

  <button
    type="button"
    class="radio-head-toggle"
    id="radio-toggle"
    aria-pressed="false"
  >
    play
  </button>

  {
    radioCards.length === 0 ? (
      <p class="radio-empty">no beats</p>
    ) : (
      <nav class="radio-queue" aria-label="radio queue">
        <h2 class="radio-queue-head">now playing</h2>
        <ul class="radio-queue-list" id="queue-now">
          {radioCards.slice(0, 1).map((card, index) => (
            <li class="radio-queue-item is-playing" data-index={index}>
              <button type="button" data-skip-to={index}>
                {card.file}
              </button>
            </li>
          ))}
        </ul>

        <h2 class="radio-queue-head">up next</h2>
        <ul class="radio-queue-list" id="queue-next">
          {radioCards.slice(1).map((card, i) => (
            <li class="radio-queue-item" data-index={i + 1}>
              <button type="button" data-skip-to={i + 1}>
                {card.file}
              </button>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</section>

<script>
  // The running order lives in the DOM: the first .radio-card is whatever is
  // playing, and finishing a track moves that card to the back of the deck.
  let queueStatusInterval: ReturnType<typeof setInterval>;
  let countdownInterval: ReturnType<typeof setInterval>;

  const queueMessages = [
    "looking for file...",
    "cant locate sample!",
    "found sample",
    "waiting for song to end...",
  ];

  const EJECT_KEY = "libre-dash:radio-ejected";

  // A full track fills the bar to 74%, not to the brim: the bar is offset 39px
  // to hide the mascot behind the CD at rest, and the mascot's own overhang has
  // to land inside the card at the far end.
  const BAR_MAX = 74;

  // Clicking the title lifts the head and the deck out of the window and drops
  // them onto the desktop in astroland's own layout; clicking again puts them
  // back. Set up before anything else so an empty radio can still be moved.
  function setupEject() {
    const stage = document.getElementById("radio-stage");
    const eject = document.getElementById("radio-eject");
    const desktop = document.getElementById("desktop");
    const home = document.querySelector<HTMLElement>(".radio");
    if (!stage || !eject || !desktop || !home) return;

    function setEjected(out: boolean) {
      if (!stage || !eject || !desktop || !home) return;
      // appendChild moves the node in a single operation. The pause-on-removal
      // rule waits for a stable state before it fires, by which time the
      // <audio> inside is back in the document — so playback carries over.
      if (out) desktop.appendChild(stage);
      else home.prepend(stage);
      stage.toggleAttribute("data-ejected", out);
      eject.setAttribute("aria-pressed", String(out));
      eject.title = out ? "jump back in" : "jump out";
      try {
        localStorage.setItem(EJECT_KEY, String(out));
      } catch {}
    }

    eject.addEventListener("click", () =>
      setEjected(!stage.hasAttribute("data-ejected")),
    );
    // role="button" buys the semantics but none of the keyboard behaviour.
    eject.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      e.preventDefault();
      setEjected(!stage.hasAttribute("data-ejected"));
    });

    try {
      if (localStorage.getItem(EJECT_KEY) === "true") setEjected(true);
    } catch {}

    // The taskbar button is the radio's off switch wherever its parts happen to
    // be. Once ejected the panel is no longer inside the window, so closing the
    // window would leave it stranded on the desktop: mirror the window's own
    // hidden state onto it instead.
    const win = document.querySelector<HTMLElement>('[data-win-id="radio"]');
    if (!win) return;
    const mirror = () => {
      stage.hidden = win.hidden;
    };
    new MutationObserver(mirror).observe(win, {
      attributes: true,
      attributeFilter: ["hidden"],
    });
    mirror();
  }

  document.addEventListener("DOMContentLoaded", () => {
    setupEject();

    const deck = document.querySelector<HTMLElement>(".radio-deck");
    const toggle = document.getElementById(
      "radio-toggle",
    ) as HTMLButtonElement | null;
    if (!deck || !toggle) return;

    const cards = () =>
      Array.from(deck.querySelectorAll<HTMLElement>(".radio-card"));
    const audios = () =>
      Array.from(deck.querySelectorAll<HTMLAudioElement>(".audio-element"));

    if (cards().length === 0) return;

    startQueueStatusCycle();

    audios().forEach((audio) => {
      const progressBar =
        audio.parentElement?.querySelector<HTMLElement>(".progress-bar");

      audio.addEventListener("timeupdate", () => {
        if (progressBar) {
          const progress = (audio.currentTime / audio.duration) * BAR_MAX || 0;
          progressBar.style.width = `${progress}%`;
        }

        // Three seconds out, the next card starts counting down.
        if (
          audio === audios()[0] &&
          audio.duration &&
          audio.duration - audio.currentTime <= 3
        ) {
          startCountdown(audio.duration - audio.currentTime);
        }
      });

      audio.addEventListener("ended", playNextTrack);
      audio.addEventListener("play", () => setToggleState(true));
      audio.addEventListener("pause", () => setToggleState(false));
    });

    function setToggleState(playing: boolean) {
      if (!toggle) return;
      toggle.textContent = playing ? "pause" : "play";
      toggle.setAttribute("aria-pressed", String(playing));
    }

    // Autoplay is deliberately not attempted — a dashboard that starts making
    // noise on load is a nuisance, and browsers block it anyway.
    toggle.addEventListener("click", () => {
      const audio = audios()[0];
      if (!audio) return;
      if (audio.paused) {
        audio
          .play()
          .catch((error: unknown) =>
            console.error("Error starting playback:", error),
          );
      } else {
        audio.pause();
      }
    });

    // Cycle the chatter on the cards that are not playing.
    function startQueueStatusCycle() {
      clearInterval(queueStatusInterval);
      queueStatusInterval = setInterval(() => {
        cards().forEach((card, i) => {
          if (i === 0) return;
          const queueElement = card.querySelector<HTMLElement>(
            ".radio-card-tophalf-queue",
          );
          if (queueElement && queueElement.style.display !== "none") {
            queueElement.textContent =
              queueMessages[Math.floor(Math.random() * queueMessages.length)];
          }
        });
      }, 4000);
    }

    function startCountdown(secondsRemaining: number) {
      clearInterval(countdownInterval);

      const nextCard = cards()[1];
      if (!nextCard) return;

      const queueElement = nextCard.querySelector<HTMLElement>(
        ".radio-card-tophalf-queue",
      );
      if (!queueElement) return;

      queueElement.style.display = "block";

      countdownInterval = setInterval(() => {
        const countdown = Math.ceil(secondsRemaining);
        if (countdown <= 3 && countdown > 0)
          queueElement.textContent = `${countdown}...`;
        secondsRemaining -= 1;
        if (secondsRemaining <= 0) clearInterval(countdownInterval);
      }, 1000);
    }

    function playNextTrack() {
      const finished = audios()[0];
      finished.pause();
      finished.currentTime = 0;

      const first = cards()[0];
      if (!first || !deck) return;
      deck.appendChild(first);

      updatePlayerStatus();

      audios()[0]
        .play()
        .catch((error: unknown) =>
          console.error("Error playing next track:", error),
        );
    }

    // Repaint the deck after a reorder: only the front card gets the speaker,
    // the status line, the disc and the mascot on its progress bar.
    function updatePlayerStatus() {
      cards().forEach((card, i) => {
        const statusElement = card.querySelector<HTMLElement>(
          ".radio-card-tophalf-status",
        );
        const queueElement = card.querySelector<HTMLElement>(
          ".radio-card-tophalf-queue",
        );
        const volumeIcon = card.querySelector<HTMLElement>(
          ".radio-card-tophalf-volume",
        );
        const disc = card.querySelector<HTMLElement>(
          ".radio-card-bottomhalf-disc",
        );

        if (statusElement)
          statusElement.style.visibility = i === 0 ? "visible" : "hidden";
        if (queueElement)
          queueElement.style.display = i === 0 ? "none" : "block";
        if (volumeIcon) volumeIcon.style.display = i === 0 ? "block" : "none";
        if (disc) disc.style.display = i === 0 ? "block" : "none";
        // The mascot is a pseudo-element, so it is styled off the card rather
        // than set inline like the rest.
        card.toggleAttribute("data-playing", i === 0);
      });

      if (deck) deck.scrollLeft = 0;
      syncQueue();
    }

    // Jump straight to a track: rotate cards to the back until the requested
    // one is in front — the same move playNextTrack() makes, just repeated.
    function skipTo(targetIndex: number) {
      if (!deck) return;
      const target = String(targetIndex);
      let deckCards = cards();

      // Bounded by the card count, so an unknown index is a no-op rather than
      // an endless spin: a full cycle leaves the deck exactly as it was.
      for (
        let i = 0;
        i < deckCards.length && deckCards[0].dataset.index !== target;
        i++
      ) {
        deck.appendChild(deckCards[0]);
        deckCards = cards();
      }
      if (deckCards[0].dataset.index !== target) return;

      audios().forEach((audio) => {
        audio.pause();
        audio.currentTime = 0;
      });

      clearInterval(countdownInterval);
      updatePlayerStatus();

      audios()[0]
        .play()
        .catch((error: unknown) =>
          console.error("Error skipping to track:", error),
        );
    }

    /* ---------- Queue list ---------- */
    const nowList = document.getElementById("queue-now");
    const nextList = document.getElementById("queue-next");

    // Every <li> keyed by the track's original index, which never changes even
    // as the deck shuffles.
    const items = new Map<string, HTMLElement>();
    document
      .querySelectorAll<HTMLElement>(".radio-queue-item")
      .forEach((item) => {
        if (item.dataset.index) items.set(item.dataset.index, item);
      });

    function syncQueue() {
      if (!nowList || !nextList) return;
      cards().forEach((card, i) => {
        const item = card.dataset.index
          ? items.get(card.dataset.index)
          : undefined;
        if (!item) return;
        // appendChild moves the node, so iterating in card order rebuilds each
        // list in order.
        (i === 0 ? nowList : nextList).appendChild(item);
        item.classList.toggle("is-playing", i === 0);
      });
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-skip-to]")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const index = btn.dataset.skipTo;
          if (index !== undefined) skipTo(Number(index));
        });
      });
  });
</script>

<style>
  /* Order rather than nesting, so the title can leave for the desktop without
     taking the play button with it. Line one is title + button; the deck and
     the queue each take a full line below. With the title gone the button is
     left on its own at the start of the line, which is where it should be. */
  .radio {
    color: #000300;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    -moz-column-gap: 10px;
    column-gap: 10px;
    row-gap: 14px;
  }

  /* Docked, the stage is only a handle for the eject: it adds no box of its
     own and lets its two children sit directly in the flex line. */
  .radio-stage {
    display: contents;
  }

  .radio-head-title {
    order: 1;
    flex: 1 1 auto;
  }
  .radio-head-toggle {
    order: 2;
    flex: none;
  }
  .radio-deck {
    order: 3;
    flex: 0 0 100%;
    min-width: 0;
  }
  .radio-empty,
  .radio-queue {
    order: 4;
    flex: 0 0 100%;
    min-width: 0;
  }

  /* astroland's BIGfuckofftext, sized for a window: Ojuju at full weight with
     the stream-player glyph riding above it. Also the eject handle. */
  .radio-head-title {
    position: relative;
    font-family: "Ojuju", sans-serif;
    font-optical-sizing: auto;
    font-weight: 800;
    font-size: 56px;
    line-height: 1;
    margin: 0;
    cursor: crosshair;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }
  .radio-head-title::before {
    content: url(/img/media_player_stream_no.png);
    position: absolute;
    top: -30px;
    left: 4px;
  }

  /* Same affordance as the window's sizer buttons. */
  .radio-head-toggle {
    font-family: "Tiny5", sans-serif;
    font-size: 16px;
    line-height: 1;
    background-color: #bdbdbd;
    border: 2px solid #000300;
    border-bottom-width: 4px;
    color: #000300;
    padding: 4px 10px;
    cursor: crosshair;
    flex: none;
  }
  .radio-head-toggle:hover {
    background-color: #00ff2f;
  }
  .radio-head-toggle[aria-pressed="true"] {
    background-color: #000300;
    color: #fffeff;
  }

  /* The deck scrolls sideways: cards keep their astroland proportions however
     narrow the window gets. */
  .radio-deck {
    display: flex;
    -moz-column-gap: 16px;
    column-gap: 16px;
    padding-top: 4px;
    padding-bottom: 8px;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .radio-queue {
    padding: 10px 12px 12px;
    background-color: #fffeff;
    border: 2px solid #000300;
    /* The radio mark, sitting in behind the queue. */
    background-image: url(/img/su00kiradi0.png);
    background-repeat: no-repeat;
    background-position: right 1px bottom -10px;
    background-size: 200px auto;
  }
  .radio-queue-head {
    font-family: "Ojuju", sans-serif;
    font-size: 20px;
    font-weight: 800;
    text-transform: lowercase;
    margin: 0 0 4px;
  }
  .radio-queue-head + .radio-queue-list {
    margin-bottom: 12px;
  }
  .radio-queue-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* One track in the queue; clicking it skips the radio straight there. */
  .radio-queue-item button {
    display: block;
    width: 100%;
    padding: 2px 0;
    border: none;
    background: none;
    color: #797676;
    font-family: "Tiny5", sans-serif;
    font-size: 18px;
    text-align: left;
    cursor: crosshair;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .radio-queue-item button::before {
    content: "* ";
    vertical-align: middle;
  }
  .radio-queue-item button:hover {
    color: #000300;
    text-decoration: underline;
  }
  .radio-queue-item.is-playing button {
    color: #000300;
  }
  .radio-queue-item.is-playing button::before {
    color: #f80000;
  }

  .radio-empty {
    font-family: "Tiny5", sans-serif;
    font-size: 16px;
    margin: 0;
  }

  /* ---------- Jumped out ----------
     Out of the window the radio drops astroland's own layout back on: the grey
     panel pinned to the bottom-right of the desktop, BIGfuckofftext lying
     behind the deck, and the cards hanging off the panel's bottom edge. The
     numbers are astroland's, .dinero .moveradio included — that override is
     what actually won there, not the 116px/18px on .moveradio itself. */
  .radio-stage[data-ejected] {
    display: block;
    position: absolute;
    right: 0;
    bottom: 96px;
    /* Two cards and half of the third. The panel's right edge is the desktop's
       right edge, so the rest of the deck runs past it and the desktop clips
       it — no overflow of our own, which would cut the cards hanging below.
       230px card + 60px gap are the deck's, 94px is its left padding. */
    width: calc(94px + 230px * 2.5 + 60px * 2);
    background-color: #d9d9d9;
    min-height: 224px;
  }

  /* Anchored to the top of the panel here, not the bottom as in astroland: out
     here the panel hangs off the bottom of the desktop, so the type reads from
     the top edge down and the cards cover its feet. */
  .radio-stage[data-ejected] .radio-head-title {
    position: absolute;
    top: 15px;
    font-size: 128px;
    text-indent: -42px;
    z-index: 1;
  }
  /* Sits above the panel's top edge, clear of the type. */
  .radio-stage[data-ejected] .radio-head-title::before {
    top: -67px;
    left: 14px;
  }

  /* No longer a scroller: the row runs as wide as it likes and the desktop
     clips it, exactly as the page did in astroland. */
  .radio-stage[data-ejected] .radio-deck {
    padding: 0 94px;
    gap: 60px;
    overflow: visible;
  }
  /* The radio mark, riding the right edge of the panel. */
  .radio-stage[data-ejected] .radio-deck::after {
    content: "";
    position: absolute;
    right: -15px;
    bottom: 0;
    width: 422px;
    height: 100%;
    background-image: url(/img/su00kiradi0.png);
    background-size: contain;
    background-repeat: no-repeat;
    z-index: 2;
  }

  /* Cards carry RadioCard.astro's scope, not this one, so reach them globally.
     They sit over the big type and hang below the panel, borderless — astroland's
     own cards have no frame; only the docked, in-window cards keep one. */
  .radio-stage[data-ejected] :global(.radio-card) {
    z-index: 2;
    bottom: -82px;
    border: none;
  }

  /* The taskbar button closes the radio whether it is docked or loose, and it
     wins over both display rules above — so it is stated after them. */
  .radio-stage[hidden] {
    display: none;
  }

  /* astroland's phone layout: full width, tighter type, no mark. It stays
     pinned rather than rejoining the flow the way it did there — out here
     there is no page flow to rejoin, only the desktop. Full width lands one
     card and half of the next on a phone, which is the layout astroland's
     24px padding was drawn for. */
  @media screen and (max-width: 576px) {
    .radio-stage[data-ejected] {
      left: 50px;
      right: 0;
      width: auto;
      bottom: 100px;
    }
    .radio-stage[data-ejected] .radio-head-title {
      text-indent: -32px;
      top: 0px;
    }
    .radio-stage[data-ejected] .radio-deck {
      padding: 0 24px;
      gap: 24px;
    }
    .radio-stage[data-ejected] .radio-deck::after {
      display: none;
    }
  }
</style>
